---
title: Research
stylesheet: "stylesheets/pages/content.css"
additional_stylesheets:
    - "stylesheets/pages/students.css"
---

<div class="content-container">
<h1>Research</h1>

<h2 id="publications">Publications</h2>
<ul class="outside_link">
    <% first_dandelion = true %>
    <% data.research.publications.each_with_index do |publication, index| %>
        <li>
            <% if publication.url.present? %>
                <a href="<%= publication.url %>">
                    <% if publication.title.start_with?('Dandelion') && first_dandelion %>
                            <h3 id="dandelion"><%= publication.title %></h3>
                            <% first_dandelion = false %>
                    <% else %>
                        <h3><%= publication.title %></h3>
                    <% end %>
                </a>
            <% else %>
                <% if publication.title.start_with?('Dandelion') && first_dandelion %>
                    <h3 id="dandelion"><%= publication.title %></h3>
                    <% first_dandelion = false %>
                <% else %>
                    <h3><%= publication.title %></h3>
                <% end %>
            <% end %>

            <p><em>Authors:</em> <%= publication.authors %></p>
            <p><em>Conference:</em> <%= publication.conference %></p>

            <% if publication.note.present? %>
                <p><strong><%= publication.note %></strong></p>
            <% end %>
        </li>
    <% end %>
</ul>
<hr>

<h2 id="dissertations">Dissertations & Reports</h2>
<ul>
    <% data.research.dissertations_reports.each do |dissertation| %>
        <li>
            <% if dissertation.url.present? %>
                <a href="<%= dissertation.url %>">
                    <h3><%= dissertation.title %></h3>
                </a>
            <% else %>
                <h3><%= dissertation.title %></h3>
            <% end %>

            <p><%= dissertation.type %> - <%= dissertation.institution %>, <%= dissertation.date %></p>
        </li>
    <% end %>
</ul>
<hr>

<h2 id="students">Students</h2>
<table id="students-table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Degree</th>
            <th>Notes</th>
        </tr>
    </thead>
    <tbody>
        <% data.research.students.each do |student| %>
            <tr>
                <td>
                    <% if student.url.present? %>
                        <a href="<%= student.url %>">
                            <%= student.name %>
                        </a>
                    <% else %>
                        <%= student.name %>
                    <% end %>
                </td>
                <td><%= student.degree %></td>
                <td>
                <% if student.note.present? %>
                    <%= student.note %>
                <% end %>
            </td>
            </tr>
        <% end %>
    </tbody>
</table>
</div>
