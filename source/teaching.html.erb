---
title: Teaching
stylesheet: "stylesheets/pages/content.css"
---

<div class="content-container">
<h1>Teaching</h1>

<ul>
<% data.teaching.courses.each_with_index do |course, i| %>
    <li>
        <a class="course-name" href="<%= course.url %>">
            <h3><%= course.name %></h3>
        </a>
        <p><em>Semesters Taught:</em> <%= course.semesters %></p>
        <p><%= course.description %></p>
    </li>
    <% unless i == data.teaching.courses.size - 1 %>
        <hr>
    <% end %>
<% end %>
</ul>
</div>
