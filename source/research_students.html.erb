---
title: Research Students
stylesheet: "stylesheets/pages/content.css"
---

<div class="content-container">
<h1>Research</h1>

<h2>Students</h2>
<ul class="outside_link">
    <% data.research.students.each do |student| %>
        <li>
            <% if student.url.present? %>
                <a href="<%= student.url %>">
                    <%= student.name %>
                </a>
            <% else %>
                <%= student.name %>
            <% end %>

             (<%= student.degree %>)
        </li>
    <% end %>
</ul>
</div>
