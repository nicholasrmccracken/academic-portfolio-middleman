---
title: News
stylesheet: "stylesheets/pages/content.css"
---

<div class="content-container">
<h1>News</h1>

<h2>Articles on <a href="research.html#dandelion">Dandelion</a></h2>
<ul>
    <% data.news.articles.each do |article| %>
        <li>
            <% if article.url.present? %>
                <a href="<%= article.url %>">
                    <h3><%= article.title %></h3>
                </a>
            <% else %>
                <h3><%= article.title %></h3>
            <% end %>
             <%= article.site %>
        </li>
    <% end %>
</ul>
<hr>

<h2>TPC Member Roles</h2>
<ul>
    <% data.news.tpc_roles.each do |tpc| %>
        <li>
            <h3><%= tpc.year %></h3>
            <ul>
                <% tpc.roles.each do |role| %>
                    <li><%= role %></li>
                <% end %>
            </ul>
        </li>
    <% end %>
</ul>
</div>
