---
title: Teaching
stylesheet: "stylesheets/pages/teaching.css"
---

<div class="course-container">
<h1>Teaching</h1>

<% data.teaching.courses.each do |course| %>
    <section>
        <a class="course-name" href="<%= course.url %>">
            <h3><%= course.name %></h3>
        </a>
        <p><strong>Semesters Taught: </strong><%= course.semesters %></p>
        <p><%= course.description %></p>
    </section>
    <hr>
<% end %>
</div>
